@startuml erd-clinical
skinparam entity {
  FontName Arial
  FontSize 10
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam shadowing false
skinparam dpi 150
title ERD Nhóm Lâm sàng, Hàng đợi & Y tế từ xa (M05–M08–M09) — MySQL 8.4

entity "user_account" as UA #EEF2FF;line:4F46E5 {
  * id : CHAR(36) <<PK>>
  --
  display_name : VARCHAR(255)
  active : BOOLEAN
  staff : BOOLEAN
}

entity "doctor" as D #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  user_id : CHAR(36) <<FK,UK>>
  active : BOOLEAN
}

entity "appointment" as AP #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  patient_id : CHAR(36) <<FK>>
  doctor_id : CHAR(36) <<FK>>
  slot_id : CHAR(36) <<FK>>
  start_at : DATETIME(6)
  end_at : DATETIME(6)
  mode : VARCHAR(16)
  status : VARCHAR(24)
  version : INT
  cancellation_reason : VARCHAR(1000)
  no_show_reason : VARCHAR(24) [V7]
}

entity "queue_ticket" as QT #FAF5FF;line:7E22CE {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  doctor_id : CHAR(36) <<FK,UK>>
  queue_date : DATE <<UK>>
  position : BIGINT <<UK>>
  status : VARCHAR(16)
  version : INT
  skip_reason : VARCHAR(1000)
  created_at : DATETIME(6)
}

entity "encounter" as EN #FAF5FF;line:7E22CE {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  status : VARCHAR(16)
  started_at : DATETIME(6)
  completed_at : DATETIME(6)
}

entity "medical_record" as MR #FAF5FF;line:7E22CE {
  * id : CHAR(36) <<PK>>
  --
  encounter_id : CHAR(36) <<FK,UK>>
  version : INT <<UK>>
  status : VARCHAR(16)
  content_encrypted : MEDIUMBLOB
  supersedes_id : CHAR(36) <<FK,UK>>
  amendment_reason : VARCHAR(1000)
  created_at : DATETIME(6)
}

entity "prescription" as PR #FAF5FF;line:7E22CE {
  * id : CHAR(36) <<PK>>
  --
  encounter_id : CHAR(36) <<FK>>
  version : INT
  status : VARCHAR(16)
  items_encrypted : MEDIUMBLOB
  created_at : DATETIME(6)
  issued_at : DATETIME(6)
}

entity "telehealth_session" as TS #F0F9FF;line:0284C7 {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  status : VARCHAR(16)
  version : INT
  patient_consented_at : DATETIME(6)
  ended_at : DATETIME(6)
}

entity "telehealth_token" as TT #F0F9FF;line:0284C7 {
  * token_hash : CHAR(64) <<PK>>
  --
  session_id : CHAR(36) <<FK>>
  user_id : CHAR(36) <<FK>>
  expires_at : DATETIME(6) <<IX>>
}

entity "telehealth_signal" as TSG #F0F9FF;line:0284C7 {
  * id : BIGINT <<PK,AI>>
  --
  session_id : CHAR(36) <<FK>>
  sender_id : CHAR(36) <<FK>>
  kind : VARCHAR(16)
  payload_encrypted : MEDIUMBLOB
  created_at : DATETIME(6)
}

UA ||-[#4F46E5]-o| D
D ||-[#0F766E]-o{ AP
D ||-[#7E22CE]-o{ QT
AP ||-[#7E22CE]-o| QT
AP ||-[#7E22CE]-o| EN
EN ||-[#7E22CE]-o{ MR
MR |o-[#7E22CE]-o| MR : supersedes_id
EN ||-[#7E22CE]-o{ PR

AP ||-[#0284C7]-o| TS
TS ||-[#0284C7]-o{ TT
TS ||-[#0284C7]-o{ TSG
UA ||-[#0284C7]-o{ TT
UA ||-[#0284C7]-o{ TSG : sender

note as N1
  medical_record (FINAL) và prescription (ISSUED) có trigger cấm UPDATE/DELETE ở mức MySQL.
  prescription.items_encrypted mã hóa AES-256-GCM toàn bộ danh mục thuốc dưới dạng JSON BLOB.
  telehealth_token lưu SHA-256 của X-Room-Token (TTL 300s); telehealth_signal mã hóa SDP/ICE.
end note

legend bottom
  |= Màu miền |= Nhóm thực thể |
  |<#4F46E5>   | M01 Danh tính gốc (user_account) |
  |<#0F766E>   | M02/M04 Bác sĩ & Lịch hẹn |
  |<#7E22CE>   | M05/M08 Hàng đợi & Lâm sàng |
  |<#0284C7>   | M09 Y tế từ xa WebRTC |
endlegend

@enduml
