@startuml erd-clinical
skinparam entity {
  BackgroundColor White
  BorderColor #555
  ArrowColor #333
  FontName Arial
  FontSize 10
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam shadowing false
skinparam dpi 150
title ERD Nhóm Lâm sàng, Hàng đợi & Y tế từ xa (M05–M08–M09) — MySQL 8.4

entity "user_account" as UA {
  * id : CHAR(36) <<PK>>
  --
  display_name : VARCHAR(255)
  active : BOOLEAN
  staff : BOOLEAN
}

entity "doctor" as D {
  * id : CHAR(36) <<PK>>
  --
  user_id : CHAR(36) <<FK,UK>>
  active : BOOLEAN
}

entity "appointment" as AP {
  * id : CHAR(36) <<PK>>
  --
  patient_id : CHAR(36) <<FK>>
  doctor_id : CHAR(36) <<FK>>
  slot_id : CHAR(36) <<FK>>
  start_at : DATETIME(6)
  end_at : DATETIME(6)
  mode : VARCHAR(16)
  status : VARCHAR(24)
  version : INT
  cancellation_reason : VARCHAR(1000)
  no_show_reason : VARCHAR(24) [V7]
}

entity "queue_ticket" as QT {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  doctor_id : CHAR(36) <<FK,UK>>
  queue_date : DATE <<UK>>
  position : BIGINT <<UK>>
  status : VARCHAR(16)
  version : INT
  skip_reason : VARCHAR(1000)
  created_at : DATETIME(6)
}

entity "encounter" as EN {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  status : VARCHAR(16)
  started_at : DATETIME(6)
  completed_at : DATETIME(6)
}

entity "medical_record" as MR {
  * id : CHAR(36) <<PK>>
  --
  encounter_id : CHAR(36) <<FK,UK>>
  version : INT <<UK>>
  status : VARCHAR(16)
  content_encrypted : MEDIUMBLOB
  supersedes_id : CHAR(36) <<FK,UK>>
  amendment_reason : VARCHAR(1000)
  created_at : DATETIME(6)
}

entity "prescription" as PR {
  * id : CHAR(36) <<PK>>
  --
  encounter_id : CHAR(36) <<FK>>
  version : INT
  status : VARCHAR(16)
  items_encrypted : MEDIUMBLOB
  created_at : DATETIME(6)
  issued_at : DATETIME(6)
}

entity "telehealth_session" as TS {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  status : VARCHAR(16)
  version : INT
  patient_consented_at : DATETIME(6)
  ended_at : DATETIME(6)
}

entity "telehealth_token" as TT {
  * token_hash : CHAR(64) <<PK>>
  --
  session_id : CHAR(36) <<FK>>
  user_id : CHAR(36) <<FK>>
  expires_at : DATETIME(6) <<IX>>
}

entity "telehealth_signal" as TSG {
  * id : BIGINT <<PK,AI>>
  --
  session_id : CHAR(36) <<FK>>
  sender_id : CHAR(36) <<FK>>
  kind : VARCHAR(16)
  payload_encrypted : MEDIUMBLOB
  created_at : DATETIME(6)
}

UA ||--o| D
D ||--o{ AP
D ||--o{ QT
AP ||--o| QT
AP ||--o| EN
AP ||--o| TS
EN ||--o{ MR
MR |o--o| MR : supersedes_id
EN ||--o{ PR
TS ||--o{ TT
TS ||--o{ TSG
UA ||--o{ TT
UA ||--o{ TSG : sender

note as N1
  medical_record (FINAL) và prescription (ISSUED) có trigger cấm UPDATE/DELETE ở mức MySQL.
  prescription.items_encrypted mã hóa AES-256-GCM toàn bộ danh mục thuốc dưới dạng JSON BLOB.
  telehealth_token lưu SHA-256 của X-Room-Token (TTL 300s); telehealth_signal mã hóa SDP/ICE.
end note

@enduml
