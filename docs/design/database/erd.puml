@startuml erd
skinparam entity {
  FontName Arial
  FontSize 9
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam shadowing false
skinparam dpi 130
left to right direction
title ERD Tổng quan — 26 bảng MySQL 8.4 / InnoDB (V1..V12 · Phân màu theo Miền)

' ── M01 / M07 Danh tính, OTP & Kiểm toán (#4F46E5) ──
entity "user_account" as UA #EEF2FF;line:4F46E5 {
  * id : CHAR(36) <<PK>>
  --
  issuer : VARCHAR(255) <<UK>>
  subject : VARCHAR(255) <<UK>>
  username : VARCHAR(255) [V4]
  display_name : VARCHAR(255)
  active : BOOLEAN
  staff : BOOLEAN [V5]
  email_encrypted : BLOB
  email_hash : CHAR(64) [V8,IX]
  phone_encrypted : BLOB [V8]
  phone_hash : CHAR(64) [V8,IX]
}

entity "user_role" as UR #EEF2FF;line:4F46E5 {
  * user_id : CHAR(36) <<PK,FK>>
  * role : VARCHAR(32) <<PK>>
}

entity "contact_otp [V9]" as CO #EEF2FF;line:4F46E5 {
  * actor_id : CHAR(36) <<PK,FK>>
  --
  email_hash : CHAR(64)
  otp_hash : CHAR(64)
  expires_at : DATETIME(6)
  sent_at : DATETIME(6)
  attempts : INT
}

entity "contact_otp_send_log [V9]" as COS #EEF2FF;line:4F46E5 {
  * id : CHAR(36) <<PK>>
  --
  email_hash : CHAR(64) <<IX>>
  sent_at : DATETIME(6) <<IX>>
}

entity "audit_event [V12]" as AE #EEF2FF;line:4F46E5 {
  * id : CHAR(36) <<PK>>
  --
  actor_id : CHAR(36) <<FK,nullable>>
  actor_type : VARCHAR(16)
  actor_label : VARCHAR(64)
  action : VARCHAR(64)
  resource_id : VARCHAR(128)
  result : VARCHAR(16)
  correlation_id : CHAR(36)
  created_at : DATETIME(6)
  chain_seq : BIGINT <<UK,V12>>
  prev_hash : CHAR(64) [V12]
  event_hash : CHAR(64) [V12]
}

entity "audit_chain_head [V12]" as ACH #EEF2FF;line:4F46E5 {
  * id : TINYINT <<PK>>
  --
  last_seq : BIGINT
  last_hash : CHAR(64)
  updated_at : DATETIME(6)
}

entity "audit_archive_batch [V12]" as AAB #EEF2FF;line:4F46E5 {
  * id : CHAR(36) <<PK>>
  --
  from_created_at : DATETIME(6)
  to_created_at : DATETIME(6)
  event_count : INT
  first_chain_seq : BIGINT
  last_chain_seq : BIGINT
  batch_hash : CHAR(64)
  retention_days : INT
  created_by : CHAR(36) <<FK,nullable>>
  created_at : DATETIME(6)
}

entity "idempotency_record" as IR #EEF2FF;line:4F46E5 {
  * actor_id : CHAR(36) <<PK,FK>>
  * operation : VARCHAR(64) <<PK>>
  * request_key : VARCHAR(128) <<PK>>
  --
  request_hash : CHAR(64)
  response_json : JSON
  expires_at : DATETIME(6)
}

' ── M02 / M03 / M04 Danh mục, Lịch làm & Đặt lịch (#0F766E) ──
entity "patient" as P #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  user_id : CHAR(36) <<FK,UK>>
}

entity "doctor" as D #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  user_id : CHAR(36) <<FK,UK>>
  active : BOOLEAN
}

entity "specialty" as SP #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  name : VARCHAR(255) <<UK>>
  active : BOOLEAN
}

entity "doctor_specialty" as DS #F0FDFA;line:0F766E {
  * doctor_id : CHAR(36) <<PK,FK>>
  * specialty_id : CHAR(36) <<PK,FK>>
}

entity "clinic_hours [V3]" as CH #F0FDFA;line:0F766E {
  * day_of_week : TINYINT <<PK>>
  --
  opens_at : CHAR(5)
  closes_at : CHAR(5)
}

entity "clinic_holiday [V6]" as HL #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  start_date : DATE <<IX>>
  end_date : DATE <<IX>>
  name : VARCHAR(255)
  closed : BOOLEAN
  opens_at : CHAR(5)
  closes_at : CHAR(5)
}

entity "availability" as AV #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  doctor_id : CHAR(36) <<FK>>
  start_at : DATETIME(6)
  end_at : DATETIME(6)
  slot_minutes : INT
  mode : VARCHAR(16)
}

entity "time_off" as TO #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  doctor_id : CHAR(36) <<FK>>
  start_at : DATETIME(6) [V11]
  end_at : DATETIME(6) [V11]
}

entity "slot" as SL #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  availability_id : CHAR(36) <<FK>>
  doctor_id : CHAR(36) <<FK,UK>>
  start_at : DATETIME(6) <<UK,V10>>
  end_at : DATETIME(6) <<UK>>
  mode : VARCHAR(16)
}

entity "appointment" as AP #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  patient_id : CHAR(36) <<FK>>
  doctor_id : CHAR(36) <<FK>>
  slot_id : CHAR(36) <<FK>>
  start_at : DATETIME(6) [V11]
  end_at : DATETIME(6) [V11]
  mode : VARCHAR(16)
  status : VARCHAR(24) [V11]
  version : INT
  cancellation_reason : VARCHAR(1000)
  no_show_reason : VARCHAR(24) [V7]
}

' ── M05 / M08 Lâm sàng & Hàng đợi (#7E22CE) ──
entity "queue_ticket" as QT #FAF5FF;line:7E22CE {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  doctor_id : CHAR(36) <<FK,UK>>
  queue_date : DATE <<UK>>
  position : BIGINT <<UK>>
  status : VARCHAR(16)
  version : INT
  skip_reason : VARCHAR(1000)
  created_at : DATETIME(6)
}

entity "encounter" as EN #FAF5FF;line:7E22CE {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  status : VARCHAR(16)
  started_at : DATETIME(6)
  completed_at : DATETIME(6)
}

entity "medical_record" as MR #FAF5FF;line:7E22CE {
  * id : CHAR(36) <<PK>>
  --
  encounter_id : CHAR(36) <<FK,UK>>
  version : INT <<UK>>
  status : VARCHAR(16)
  content_encrypted : MEDIUMBLOB
  supersedes_id : CHAR(36) <<FK,UK>>
  amendment_reason : VARCHAR(1000)
  created_at : DATETIME(6)
}

entity "prescription" as PR #FAF5FF;line:7E22CE {
  * id : CHAR(36) <<PK>>
  --
  encounter_id : CHAR(36) <<FK>>
  version : INT
  status : VARCHAR(16)
  items_encrypted : MEDIUMBLOB
  created_at : DATETIME(6)
  issued_at : DATETIME(6)
}

' ── M09 Y tế từ xa WebRTC (#0284C7) ──
entity "telehealth_session" as TS #F0F9FF;line:0284C7 {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  status : VARCHAR(16)
  version : INT
  patient_consented_at : DATETIME(6)
  ended_at : DATETIME(6)
}

entity "telehealth_token" as TT #F0F9FF;line:0284C7 {
  * token_hash : CHAR(64) <<PK>>
  --
  session_id : CHAR(36) <<FK>>
  user_id : CHAR(36) <<FK>>
  expires_at : DATETIME(6)
}

entity "telehealth_signal" as TSG #F0F9FF;line:0284C7 {
  * id : BIGINT <<PK,AI>>
  --
  session_id : CHAR(36) <<FK>>
  sender_id : CHAR(36) <<FK>>
  kind : VARCHAR(16)
  payload_encrypted : MEDIUMBLOB
  created_at : DATETIME(6)
}

' ── M06 Thông báo Outbox (#C2410C) ──
entity "notification_job" as NJ #FFF7ED;line:C2410C {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  appointment_version : INT <<UK>>
  event_type : VARCHAR(32) <<UK>>
  status : VARCHAR(16)
  attempts : INT
  due_at : DATETIME(6)
  lease_until : DATETIME(6)
  lease_token : CHAR(36)
  last_error : VARCHAR(64)
  estimated_start_at : DATETIME(6) [V7]
}

