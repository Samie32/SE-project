@startuml erd-infrastructure
skinparam entity {
  FontName Arial
  FontSize 10
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam shadowing false
skinparam dpi 150
title ERD Nhóm Hạ tầng, Danh tính, OTP & Thông báo (M01–M06–M07) — MySQL 8.4

entity "user_account" as UA #EEF2FF;line:4F46E5 {
  * id : CHAR(36) <<PK>>
  --
  issuer : VARCHAR(255) <<UK>>
  subject : VARCHAR(255) <<UK>>
  username : VARCHAR(255) [V4]
  display_name : VARCHAR(255)
  active : BOOLEAN
  staff : BOOLEAN [V5]
  email_encrypted : BLOB
  email_hash : CHAR(64) [V8,IX]
  phone_encrypted : BLOB [V8]
  phone_hash : CHAR(64) [V8,IX]
}

entity "user_role" as UR #EEF2FF;line:4F46E5 {
  * user_id : CHAR(36) <<PK,FK>>
  * role : VARCHAR(32) <<PK>>
}

entity "contact_otp [V9]" as CO #EEF2FF;line:4F46E5 {
  * actor_id : CHAR(36) <<PK,FK>>
  --
  email_hash : CHAR(64) <<IX>>
  otp_hash : CHAR(64)
  expires_at : DATETIME(6) <<IX>>
  sent_at : DATETIME(6) <<IX>>
  attempts : INT
}

entity "contact_otp_send_log [V9]" as COS #EEF2FF;line:4F46E5 {
  * id : CHAR(36) <<PK>>
  --
  email_hash : CHAR(64) <<IX>>
  sent_at : DATETIME(6) <<IX>>
}

entity "audit_event [V1,V2,V12]" as AE #EEF2FF;line:4F46E5 {
  * id : CHAR(36) <<PK>>
  --
  actor_id : CHAR(36) <<FK,nullable>>
  actor_type : VARCHAR(16) <<IX>>
  actor_label : VARCHAR(64)
  action : VARCHAR(64) <<IX>>
  resource_id : VARCHAR(128) <<IX>>
  result : VARCHAR(16) <<IX>>
  correlation_id : CHAR(36) <<IX>>
  created_at : DATETIME(6) <<IX>>
  chain_seq : BIGINT <<UK,V12>>
  prev_hash : CHAR(64) [V12]
  event_hash : CHAR(64) [V12]
}

entity "audit_chain_head [V12]" as ACH #EEF2FF;line:4F46E5 {
  * id : TINYINT <<PK,CHECK=1>>
  --
  last_seq : BIGINT
  last_hash : CHAR(64)
  updated_at : DATETIME(6)
}

entity "audit_archive_batch [V12]" as AAB #EEF2FF;line:4F46E5 {
  * id : CHAR(36) <<PK>>
  --
  from_created_at : DATETIME(6)
  to_created_at : DATETIME(6)
  event_count : INT
  first_chain_seq : BIGINT
  last_chain_seq : BIGINT
  batch_hash : CHAR(64)
  retention_days : INT
  created_by : CHAR(36) <<FK,nullable>>
  created_at : DATETIME(6) <<IX>>
  notes : VARCHAR(500)
}

entity "idempotency_record" as IR #EEF2FF;line:4F46E5 {
  * actor_id : CHAR(36) <<PK,FK>>
  * operation : VARCHAR(64) <<PK>>
  * request_key : VARCHAR(128) <<PK>>
  --
  request_hash : CHAR(64)
  response_json : JSON
  expires_at : DATETIME(6)
}

entity "appointment" as AP #F0FDFA;line:0F766E {
  * id : CHAR(36) <<PK>>
  --
  patient_id : CHAR(36) <<FK>>
  doctor_id : CHAR(36) <<FK>>
  slot_id : CHAR(36) <<FK>>
  start_at : DATETIME(6)
  end_at : DATETIME(6)
  mode : VARCHAR(16)
  status : VARCHAR(24)
  version : INT
  no_show_reason : VARCHAR(24) [V7]
}

entity "notification_job" as NJ #FFF7ED;line:C2410C {
  * id : CHAR(36) <<PK>>
  --
  appointment_id : CHAR(36) <<FK,UK>>
  appointment_version : INT <<UK>>
  event_type : VARCHAR(32) <<UK>>
  status : VARCHAR(16) <<IX>>
  attempts : INT
  due_at : DATETIME(6) <<IX>>
  lease_until : DATETIME(6) <<IX>>
  lease_token : CHAR(36)
  last_error : VARCHAR(64)
  estimated_start_at : DATETIME(6) [V7]
}

UA ||-[#4F46E5]-o{ UR
UA ||-[#4F46E5]-o| CO
CO .[#4F46E5]. COS : email_hash
UA ||-[#4F46E5]-o{ AE : actor_id
ACH .[#4F46E5]. AE : chain_seq / head
UA ||-[#4F46E5]-o{ AAB : created_by
UA ||-[#4F46E5]-o{ IR : actor_id
AP ||-[#C2410C]-o{ NJ : transactional outbox

note as N1
  notification_job đóng vai trò transactional outbox (UNIQUE trên appointment_id, appointment_version, event_type).
  audit_event & audit_archive_batch bảo vệ bằng trigger BEFORE UPDATE/DELETE; V12 thêm chuỗi băm HMAC-SHA256-CHAIN-V1 qua audit_chain_head.
  contact_otp_send_log chặn spam OTP qua email đích (cooldown 30s, tối đa 5 lượt / 3600s).
end note

legend bottom
  |= Màu miền |= Nhóm thực thể |
  |<#4F46E5>   | M01/M07 Danh tính, OTP, Idempotency & Audit |
  |<#0F766E>   | M04 Lịch hẹn tham chiếu |
  |<#C2410C>   | M06 Thông báo Outbox (notification_job) |
endlegend

@enduml
