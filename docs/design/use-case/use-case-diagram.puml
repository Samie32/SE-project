@startuml use-case-diagram
skinparam usecase {
  BackgroundColor White
  BorderColor #555
  ArrowColor #333
}
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FAFAFA
skinparam packageBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam dpi 150
title Tổng quan Use Case — 27 ca sử dụng (UML 2.5)

left to right direction

actor "Người dùng" as User
actor "Bệnh nhân" as Patient
actor "Bác sĩ" as Doctor
actor "Lễ tân" as Receptionist
actor "Quản trị viên" as Admin
actor "Kiểm toán viên" as Auditor
actor "Keycloak / Google\n(OIDC PKCE)" as IdP
actor "Dịch vụ Email\n(SMTP / Brevo)" as EmailSvc
actor "WebRTC / coturn\n(STUN / TURN 3478)" as VideoNet

rectangle "Hệ thống phòng khám ClinicCare" {

  package "M01 & M02 & M03 — Danh tính, Danh mục & Lịch làm" {
    usecase "UC-01 Đăng nhập, Google,\nQuên MK & OTP liên hệ" as UC01
    usecase "UC-02 Quản lý vai trò /\nKiểm soát truy cập" as UC02
    usecase "UC-27 Tra cứu & Khóa/Mở\ntài khoản bệnh nhân" as UC27
    usecase "UC-03 Quản lý bác sĩ\nvà chuyên khoa" as UC03
    usecase "UC-04 Ngừng nhận lịch /\nVô hiệu hóa bác sĩ" as UC04
    usecase "UC-05 Quản lý lịch làm việc" as UC05
    usecase "UC-06 Lịch nghỉ, Giờ phòng\nkhám & Ngày nghỉ lễ" as UC06
  }

  package "M03, M04 & M08 — Lịch hẹn & Hàng đợi" {
    usecase "UC-07 Tìm slot khả dụng" as UC07
    usecase "UC-08 Đặt lịch hẹn" as UC08
    usecase "UC-09 Đổi lịch hẹn" as UC09
    usecase "UC-10 Hủy lịch hẹn" as UC10
    usecase "UC-11 Tiến trình lịch hẹn\n(Khám / Hoàn tất)" as UC11
    usecase "UC-25 Báo chậm giờ khám\n(DELAY_NOTICE)" as UC25
    usecase "UC-26 Ghi nhận vắng hẹn\n(NO_SHOW & mời đặt lại)" as UC26
    usecase "UC-19 Check-in bệnh nhân" as UC19
    usecase "UC-20 Gọi bệnh nhân\ntiếp theo" as UC20
    usecase "UC-21 Trả phiếu về\ncuối hàng đợi" as UC21
  }

  package "M05 & M09 — Lâm sàng & Khám từ xa WebRTC" {
    usecase "UC-12 Xem lịch sử được phép" as UC12
    usecase "UC-13 Ghi / Chốt /\nBổ sung hồ sơ" as UC13
    usecase "UC-14 Kê & phát hành\nđơn thuốc" as UC14
    usecase "UC-22 Chuẩn bị & vào\nphòng chờ từ xa" as UC22
    usecase "UC-23 Tham gia / Bắt đầu\nphiên từ xa WebRTC" as UC23
    usecase "UC-24 Nối lại (ICE restart) /\nKết thúc phiên từ xa" as UC24
  }

  package "M06 & M07 — Thông báo & Kiểm toán" {
    usecase "UC-15 Nhận email xác nhận,\nnhắc lịch & báo chậm" as UC15
    usecase "UC-16 Giám sát lỗi gửi\nthông báo (Outbox)" as UC16
    usecase "UC-17 Ghi sự kiện kiểm toán\n(fail-closed nội bộ)" as UC17
    usecase "UC-18 Tra cứu lịch sử\nkiểm toán" as UC18
  }
}

note as N1
  UC-17 là hành vi audit fail-closed nội bộ trong giao dịch, khác với UC-18 của Kiểm toán viên.
  UC-02 phân quyền RBAC + sở hữu tài nguyên là điều kiện bắt buộc cho mọi API bảo vệ.
  UC-27 tra cứu bệnh nhân dùng blind index HMAC-SHA256 (chỉ UUID / email / SĐT; cấm tìm theo tên).
end note

