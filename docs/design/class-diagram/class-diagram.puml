@startuml class-diagram
skinparam class {
  FontName Arial
  FontSize 10
  HeaderFontColor #0F172A
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam shadowing false
skinparam dpi 150
title Mô hình miền (PIM — Domain Model UML 2.5) · 26 thực thể V1..V12 (Phân màu theo Miền)

' ── M01 / M07 Danh tính, OTP & Kiểm toán (#4F46E5) ──
class UserAccount #EEF2FF;line:4F46E5 {
  id : UUID
  issuer : String
  subject : String
  username : String
  displayName : String
  active : Boolean
  staff : Boolean
  emailHash : String
  phoneHash : String
  contactLookup()
  updateAccess(active, reason)
}

class UserRole #EEF2FF;line:4F46E5 {
  role : VaiTro
}

class ContactOtp #EEF2FF;line:4F46E5 {
  emailHash : String
  otpHash : String
  expiresAt : Instant
  attempts : Integer
  verifyAndConsume()
}

class ContactOtpSendLog #EEF2FF;line:4F46E5 {
  emailHash : String
  sentAt : Instant
}

class AuditEvent #EEF2FF;line:4F46E5 {
  id : UUID
  actorType : USER_hoac_SYSTEM
  actorLabel : String
  action : String
  resourceId : String
  result : String
  correlationId : UUID
  chainSeq : Long
  prevHash : String
  eventHash : String
}

class AuditChainHead #EEF2FF;line:4F46E5 {
  id : int
  lastSeq : Long
  lastHash : String
  updatedAt : Instant
  verifyChain()
}

class AuditArchiveBatch #EEF2FF;line:4F46E5 {
  id : UUID
  fromCreatedAt : Instant
  toCreatedAt : Instant
  eventCount : Integer
  batchHash : String
  retentionDays : Integer
  sealBatch()
}

class IdempotencyRecord #EEF2FF;line:4F46E5 {
  operation : String
  requestKey : String
  requestHash : String
  expiresAt : Instant
}

' ── M02 / M03 / M04 Danh mục, Lịch làm & Đặt lịch (#0F766E) ──
class Patient #F0FDFA;line:0F766E {
  id : UUID
}

class Doctor #F0FDFA;line:0F766E {
  id : UUID
  active : Boolean
}

class Specialty #F0FDFA;line:0F766E {
  id : UUID
  name : String
  active : Boolean
}

class ClinicHours #F0FDFA;line:0F766E {
  dayOfWeek : int
  opensAt : String
  closesAt : String
}

class ClinicHoliday #F0FDFA;line:0F766E {
  id : UUID
  startDate : LocalDate
  endDate : LocalDate
  name : String
  closed : Boolean
}

class Availability #F0FDFA;line:0F766E {
  id : UUID
  startAt : Instant
  endAt : Instant
  slotMinutes : Integer
  mode : CheDoKham
}

class TimeOff #F0FDFA;line:0F766E {
  id : UUID
  startAt : Instant
  endAt : Instant
}

class Slot #F0FDFA;line:0F766E {
  id : UUID
  startAt : Instant
  endAt : Instant
  mode : CheDoKham
}

class Appointment #F0FDFA;line:0F766E {
  id : UUID
  status : TrangThaiLichHen
  mode : CheDoKham
  version : Integer
  cancellationReason : String
  noShowReason : NoShowReason
  reschedule()
  cancel()
  markNoShow()
}

' ── M05 / M08 Lâm sàng & Hàng đợi (#7E22CE) ──
class QueueTicket #FAF5FF;line:7E22CE {
  id : UUID
  queueDate : LocalDate
  position : Long
  status : TrangThaiPhieu
  version : Integer
  skipReason : String
  callNext()
  skip()
}

class Encounter #FAF5FF;line:7E22CE {
  id : UUID
  status : TrangThaiLanKham
  startedAt : Instant
  completedAt : Instant
}

class MedicalRecord #FAF5FF;line:7E22CE {
  id : UUID
  version : Integer
  status : TrangThaiHoSo
  contentEncrypted : byte[]
  amendmentReason : String
  finalize()
  amend()
}

class Prescription #FAF5FF;line:7E22CE {
  id : UUID
  version : Integer
  status : TrangThaiDonThuoc
  itemsEncrypted : byte[]
  issuedAt : Instant
  issue()
}

' ── M09 Y tế từ xa WebRTC (#0284C7) ──
class TelehealthSession #F0F9FF;line:0284C7 {
  id : UUID
  status : TrangThaiPhien
  version : Integer
  patientConsentedAt : Instant
  endedAt : Instant
  join()
  start()
  reconnect()
  end()
}

class TelehealthToken #F0F9FF;line:0284C7 {
  tokenHash : String
  expiresAt : Instant
}

class TelehealthSignal #F0F9FF;line:0284C7 {
  kind : OFFER_ANSWER_ICE
  payloadEncrypted : byte[]
}

' ── M06 Thông báo Outbox (#C2410C) ──
class NotificationJob #FFF7ED;line:C2410C {
  id : UUID
  appointmentVersion : Integer
  eventType : String
  status : String
  attempts : Integer
  dueAt : Instant
  estimatedStartAt : Instant
}

' ── Quan hệ chuẩn UML 2.5 ──
' Composition (*--): phụ thuộc vòng đời chặt
UserAccount "1" *-[#4F46E5]- "1..*" UserRole
UserAccount "1" *-[#4F46E5]- "0..1" ContactOtp
Availability "1" *-[#0F766E]- "0..*" Slot
Encounter "1" *-[#7E22CE]- "0..*" MedicalRecord : phiên bản
Encounter "1" *-[#7E22CE]- "0..*" Prescription : chứa items_encrypted JSON
TelehealthSession "1" *-[#0284C7]- "0..*" TelehealthToken
TelehealthSession "1" *-[#0284C7]- "0..*" TelehealthSignal

' Association (--): thực thể độc lập / bảo toàn lịch sử y tế
UserAccount "1" -[#4F46E5]- "0..1" Doctor
UserAccount "1" -[#4F46E5]- "0..1" Patient
UserAccount "1" -[#4F46E5]- "0..*" IdempotencyRecord

Doctor "*" -[#0F766E]- "*" Specialty
Doctor "1" -[#0F766E]- "0..*" Availability
Doctor "1" -[#0F766E]- "0..*" TimeOff
Slot "1" -[#0F766E]- "0..*" Appointment : tối đa 1 hiệu lực
Doctor "1" -[#0F766E]- "0..*" Appointment
Patient "1" -[#0F766E]- "0..*" Appointment

Appointment "1" -[#7E22CE]- "0..1" QueueTicket
Appointment "1" -[#7E22CE]- "0..1" Encounter
MedicalRecord "0..1" -[#7E22CE]-> "0..1" MedicalRecord : supersedes (bổ sung)
Appointment "1" -[#0284C7]- "0..1" TelehealthSession
Appointment "1" -[#C2410C]- "0..*" NotificationJob : outbox giao dịch

' Dependency (..>): tham chiếu / chính sách / audit / rate-log
UserAccount "1" .[#4F46E5].> "0..*" AuditEvent : actor
AuditChainHead "1" .[#4F46E5].> "0..*" AuditEvent : chuỗi HMAC-SHA256
UserAccount "1" .[#4F46E5].> "0..*" AuditArchiveBatch : createdBy
ContactOtp .[#4F46E5].> ContactOtpSendLog : theo emailHash
ClinicHours .[#0F766E].> Availability : ràng buộc giờ mở ca
ClinicHoliday .[#0F766E].> Availability : ưu tiên ngày lễ

legend bottom
  |= Màu miền |= Nhóm thực thể |= Ký pháp UML 2.5 |
  |<#4F46E5>   | M01/M07 Danh tính, OTP & Audit | Hình thoi đặc: Composition (gắn vòng đời) |
  |<#0F766E>   | M02/M03/M04 Danh mục & Lịch hẹn | Đường liền: Association (bảo toàn lịch sử) |
  |<#7E22CE>   | M05/M08 Lâm sàng & Hàng đợi | Nét đứt mũi tên: Dependency (chính sách / log) |
  |<#0284C7>   | M09 Y tế từ xa WebRTC | |
  |<#C2410C>   | M06 Thông báo Outbox | |
endlegend

@enduml
