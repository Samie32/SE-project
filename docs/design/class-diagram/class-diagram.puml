@startuml class-diagram
skinparam class {
  BackgroundColor White
  BorderColor #555
  ArrowColor #333
  FontName Arial
  FontSize 10
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam shadowing false
skinparam dpi 150
title Mô hình miền (PIM — Domain Model UML 2.5) · Đồng bộ 24 thực thể V1..V11

class UserAccount {
  id : UUID
  issuer : String
  subject : String
  username : String
  displayName : String
  active : Boolean
  staff : Boolean
  emailHash : String
  phoneHash : String
  contactLookup()
  updateAccess(active, reason)
}

class UserRole {
  role : VaiTro
}

class ContactOtp {
  emailHash : String
  otpHash : String
  expiresAt : Instant
  attempts : Integer
  verifyAndConsume()
}

class ContactOtpSendLog {
  emailHash : String
  sentAt : Instant
}

class Patient {
  id : UUID
}

class Doctor {
  id : UUID
  active : Boolean
}

class Specialty {
  id : UUID
  name : String
  active : Boolean
}

class ClinicHours {
  dayOfWeek : int
  opensAt : String
  closesAt : String
}

class ClinicHoliday {
  id : UUID
  startDate : LocalDate
  endDate : LocalDate
  name : String
  closed : Boolean
}

class Availability {
  id : UUID
  startAt : Instant
  endAt : Instant
  slotMinutes : Integer
  mode : CheDoKham
}

class TimeOff {
  id : UUID
  startAt : Instant
  endAt : Instant
}

class Slot {
  id : UUID
  startAt : Instant
  endAt : Instant
  mode : CheDoKham
}

class Appointment {
  id : UUID
  status : TrangThaiLichHen
  mode : CheDoKham
  version : Integer
  cancellationReason : String
  noShowReason : NoShowReason
  reschedule()
  cancel()
  markNoShow()
}

class QueueTicket {
  id : UUID
  queueDate : LocalDate
  position : Long
  status : TrangThaiPhieu
  version : Integer
  skipReason : String
  callNext()
  skip()
}

class Encounter {
  id : UUID
  status : TrangThaiLanKham
  startedAt : Instant
  completedAt : Instant
}

class MedicalRecord {
  id : UUID
  version : Integer
  status : TrangThaiHoSo
  contentEncrypted : byte[]
  amendmentReason : String
  finalize()
  amend()
}

class Prescription {
  id : UUID
  version : Integer
  status : TrangThaiDonThuoc
  itemsEncrypted : byte[]
  issuedAt : Instant
  issue()
}

class TelehealthSession {
  id : UUID
  status : TrangThaiPhien
  version : Integer
  patientConsentedAt : Instant
  endedAt : Instant
  join()
  start()
  reconnect()
  end()
}

class TelehealthToken {
  tokenHash : String
  expiresAt : Instant
}

class TelehealthSignal {
  kind : OFFER_ANSWER_ICE
  payloadEncrypted : byte[]
}

class NotificationJob {
  id : UUID
  appointmentVersion : Integer
  eventType : String
  status : String
  attempts : Integer
  dueAt : Instant
  estimatedStartAt : Instant
}

class AuditEvent {
  id : UUID
  actorType : USER_hoac_SYSTEM
  actorLabel : String
  action : String
  resourceId : String
  result : String
  correlationId : UUID
}

class IdempotencyRecord {
  operation : String
  requestKey : String
  requestHash : String
  expiresAt : Instant
}

UserAccount "1" *-- "1..*" UserRole
UserAccount "1" -- "0..1" ContactOtp
UserAccount "1" -- "0..1" Doctor
UserAccount "1" -- "0..1" Patient
UserAccount "1" ..> "0..*" AuditEvent : actor
UserAccount "1" -- "0..*" IdempotencyRecord
UserAccount .. ContactOtpSendLog : theo emailHash

Doctor "*" -- "*" Specialty
Doctor "1" *-- "0..*" Availability
Doctor "1" *-- "0..*" TimeOff
ClinicHours .. Availability : ràng buộc giờ mở ca
ClinicHoliday .. Availability : ưu tiên ngày lễ

Availability "1" *-- "0..*" Slot
Slot "1" -- "0..*" Appointment : lịch sử; tối đa 1 hiệu lực
Doctor "1" -- "0..*" Appointment
Patient "1" -- "0..*" Appointment

Appointment "1" *-- "0..1" QueueTicket
Appointment "1" *-- "0..1" Encounter
Appointment "1" *-- "0..1" TelehealthSession
Appointment "1" *-- "0..*" NotificationJob : outbox giao dịch

Encounter "1" *-- "0..*" MedicalRecord : phiên bản
MedicalRecord "0..1" --> "0..1" MedicalRecord : supersedes (bổ sung)
Encounter "1" *-- "0..*" Prescription : chứa items_encrypted JSON

TelehealthSession "1" *-- "0..*" TelehealthToken
TelehealthSession "1" *-- "0..*" TelehealthSignal

@enduml
