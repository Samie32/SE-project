@startuml deployment-azure
skinparam node {
  FontName Arial
  FontSize 10
}
skinparam component {
  BackgroundColor White
  BorderColor #64748B
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam shadowing false
skinparam dpi 150
title Sơ đồ Triển khai Azure VM Internet Demo (compose.internet.yaml — 20.187.80.11 · Phân màu Giao thức)

node "Thiết bị người dùng\n(Desktop / Mobile)" as Client #EFF6FF;line:1D4ED8 {
  component "Trình duyệt React SPA\n& WebRTC P2P Client" as Browser
}

cloud "GitHub Actions CI/CD" as GHA #FEF2F2;line:B91C1C {
  component "5 Jobs: backend · frontend · api-contract\ndeploy-azure-demo · post-deploy-smoke" as CI
}

node "Azure Linux VM (20.187.80.11 · DuckDNS)" as VM #FAFAFA;line:64748B {
  node "gateway (caddy:2-alpine)" as Caddy #EFF6FF;line:1D4ED8 {
    component "TLS Let's Encrypt · HSTS · CSP · XFO\ncliniccare-demo.duckdns.org (:443)\ncliniccare-auth.duckdns.org (:443)" as TLSEdge
  }

  node "frontend (Nginx 1.28)" as FE #EFF6FF;line:1D4ED8 {
    component "Static SPA + CSP\nRate-limit /api/me/contact/otp (10r/m -> 429)" as NginxProd
  }

  node "ice-config (Node 22)" as ICE #FAF5FF;line:7E22CE {
    component "/api/webrtc/ice (:8090)\nSinh TURN credentials ephemeral" as IceSvc
  }

  node "backend (Spring Boot 3.5 · Java 21)" as BE #F0FDFA;line:0F766E {
    component "REST API + Workers\nHikariCP (30) · AES-256-GCM · HMAC-SHA256" as App
  }

  node "keycloak (26.4.0)" as KC #FFF7ED;line:C2410C {
    component "OIDC + PKCE + Google Broker\nKhóa tạm 5 lần sai + Quên MK SMTP" as IdP
  }

  node "turn (coturn 4.7.0 · network_mode host)" as TURN #FAF5FF;line:7E22CE {
    component "STUN / TURN UDP+TCP :3478\nRelay UDP 49160–49200" as Coturn
  }

  database "mysql:8.4 (InnoDB)" as DB #F0FDF4;line:15803D {
    component "24 bảng V1..V11\nEncrypted backup + restore test" as MySQL
  }

  component "scripts/deploy-azure-demo.sh\n(Auto git reset --hard rollback khi health fail)" as DeployScript #FEF2F2;line:B91C1C
}

cloud "Dịch vụ ngoài" as Ext #FFF7ED;line:C2410C {
  component "Google OAuth2 IdP" as Google
  component "Brevo SMTP Relay\n(TLS :587)" as Brevo
}

Browser -[#1D4ED8]-> TLSEdge : HTTPS :443
Browser <-[#7E22CE]-> Coturn : STUN / TURN :3478 & 49160-49200
CI -[#B91C1C]-> DeployScript : SSH Deploy -> Healthcheck -> Rollback nếu lỗi
CI -[#B91C1C]-> TLSEdge : post-deploy-smoke (6/6 checks HTTP + STUN :3478)

TLSEdge -[#1D4ED8]-> NginxProd : cliniccare-demo / & /api/**
TLSEdge -[#7E22CE]-> IceSvc : /api/webrtc/ice
TLSEdge -[#C2410C]-> KC : cliniccare-auth /realms/clinic/**

NginxProd -[#1D4ED8]-> App : /api/** (limit OTP 10r/m)
App -[#15803D]-> MySQL : JDBC UTC (SELECT ... FOR UPDATE)
App -[#C2410C]-> KC : JWKS + Staff Provisioning API
App -[#C2410C]-> Brevo : SMTP :587 (OTP & NotificationWorker)
KC -[#C2410C]-> Google : Google OAuth2 Login
KC -[#C2410C]-> Brevo : Email Quên mật khẩu

note as N1
  Luồng bảo vệ đa tầng OTP (NFR-15): Nginx IP rate-limit (10r/m -> 429) -> ContactOtpService (cooldown 30s, <=5/h) -> MySQL contact_otp.
  Bản triển khai tự động phát hiện health fail trên Azure VM và rollback về prev_sha (NFR-16).
end note

legend bottom
  |= Màu luồng |= Giao thức / Tuyến vận hành |
  |<#1D4ED8>   | HTTPS / TLS Client & REST API |
  |<#15803D>   | MySQL 8.4 Giao dịch & Backup |
  |<#C2410C>   | OIDC PKCE / Google OAuth2 / Brevo SMTP :587 |
  |<#7E22CE>   | WebRTC ICE Config & coturn STUN/TURN :3478 |
  |<#B91C1C>   | CI/CD Deploy, Auto-Rollback & Smoke Test |
endlegend

@enduml
