@startuml deployment
skinparam node {
  BackgroundColor White
  BorderColor #555
  FontName Arial
  FontSize 10
}
skinparam component {
  BackgroundColor #F5F5F5
  BorderColor #777
}
skinparam database {
  BackgroundColor White
  BorderColor #555
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam shadowing false
skinparam dpi 150
title Sơ đồ Triển khai Docker Compose (Phát triển & Kiểm thử cục bộ — compose.yaml)

node "Thiết bị người dùng\n(localhost Browser)" as Client {
  component "React 18 + Vite 8\n(WebRTC Client)" as SPA
}

node "Docker Network: clinic-telehealth" {
  node "frontend (Nginx 1.28)" as FE {
    component "Static SPA + CSP\n127.0.0.1:5173:80" as NginxLocal
    component "limit_req otp_ip 10r/m\nProxy /api/** -> backend" as ProxyLocal
  }

  node "backend (Spring Boot 3.5)" as BE {
    component "REST API + Workers\n127.0.0.1:8080" as SBLocal
    component "Flyway V1..V11 + DemoData" as FlywayLocal
  }

  node "keycloak (26.4.0 dev)" as KC {
    component "OIDC Realm: clinic\n127.0.0.1:8180" as KCLocal
    component "Theme cliniccare" as ThemeLocal
  }

  node "mailpit (v1.27.0)" as MP {
    component "SMTP :1025 · Web UI :8025" as MailpitLocal
  }

  database "mysql:8.4 (InnoDB)" as DB {
    component "DB clinic · Volume mysql-data\n127.0.0.1:3307:3306" as MySQLLocal
  }
}

SPA --> NginxLocal : HTTP :5173
SPA <--> KCLocal : OIDC Auth Code + PKCE :8180
ProxyLocal --> SBLocal : HTTP :8080
SBLocal --> MySQLLocal : JDBC UTC
SBLocal --> KCLocal : JWKS /certs & Admin API
SBLocal --> MailpitLocal : SMTP :1025 (OTP + Nhắc lịch)

note as N1
  Biến môi trường cấu hình trong .env (setup-local.ps1 sinh khóa AES/HMAC & mật khẩu giả).
  Bản triển khai Internet Azure VM sử dụng compose.internet.yaml + Caddy 2 + coturn + Brevo SMTP xem ở deployment-azure.png.
end note

@enduml
