@startuml system-architecture
skinparam rectangle {
  BackgroundColor White
  BorderColor #555
  FontName Arial
  FontSize 10
}
skinparam component {
  BackgroundColor White
  BorderColor #555
}
skinparam actor {
  BackgroundColor White
  BorderColor #555
}
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825
skinparam cloud {
  BackgroundColor #F5F5F5
  BorderColor #888
}
skinparam database {
  BackgroundColor White
  BorderColor #555
}
skinparam shadowing false
skinparam dpi 150
title Kiến trúc hệ thống ClinicCare — Layered Modular Monolith (Kruchten 4+1 Views)

actor "Bệnh nhân" as Patient
actor "Nhân viên\nphòng khám" as Staff

component "React 18 + TypeScript 5\nWeb / Mobile Browser" as Browser
component "Nginx 1.28\nSPA + Rate-limit OTP (10r/m)" as Nginx

rectangle "Spring Boot 3.5 — Modular Monolith (Java 21)" as Backend {
  component "Controllers / REST API\n(OpenAPI 3.1 + RFC 9457)" as Controllers
  component "M01 Auth & Access\nContactOtp + Provisioning" as M01
  component "M02 Catalog (Bác sĩ/CK)\nM03 Schedule & ClinicHours" as M023
  component "M04 AppointmentService\n(Idempotency + Lock Order)" as M04
  component "M05 ClinicalService\n(Hồ sơ + Đơn thuốc)" as M05
  component "M08 Workflow (Hàng đợi/NO_SHOW)\nM09 Telehealth (Signaling P2P)" as M089
  component "M06 NotificationWorker\nM07 Audit & Crypto (GCM/HMAC)" as M067
}

cloud "Keycloak 26.4 +\nGoogle OAuth2\n(OIDC PKCE)" as IdP
cloud "SMTP Provider\n(Mailpit / Brevo TLS)" as EmailSvc
cloud "coturn 4.7\n(STUN/TURN :3478)" as TurnSvc
database "MySQL 8.4 (InnoDB)\n24 bảng · Flyway V1..V11" as MySQL

Patient --> Browser
Staff --> Browser
Browser --> Nginx : HTTPS / REST API
Browser <--> IdP : OIDC PKCE / Google
Browser <--> TurnSvc : WebRTC P2P / TURN Relay

Nginx --> Controllers : /api/** (limit OTP 10r/m)
Controllers --> M01
Controllers --> M023
Controllers --> M04
Controllers --> M05
Controllers --> M089
Controllers --> M067

M01 --> IdP : JWT JWKS & Admin API
M01 --> EmailSvc : Gửi OTP đổi email
M067 --> EmailSvc : Nhắc lịch / Chậm giờ / NO_SHOW

M01 --> MySQL : HikariCP (pool 30)
M023 --> MySQL
M04 --> MySQL : SELECT ... FOR UPDATE\n(Doctor -> Patient)
M05 --> MySQL
M089 --> MySQL
M067 --> MySQL : Audit append-only\n& notification_job lease

note as N1
  Mọi truy cập PHI qua RBAC + sở hữu và ghi AuditEvent fail-closed cùng giao dịch.
  /api/webrtc/ice cấp cấu hình STUN/TURN ephemeral cho kết nối WebRTC tới coturn :3478.
end note

@enduml
