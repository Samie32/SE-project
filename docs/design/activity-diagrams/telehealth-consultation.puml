@startuml telehealth-consultation
skinparam ActivityBorderColor #555
skinparam ActivityBackgroundColor #FAFAFA
skinparam ActivityDiamondBorderColor #555
skinparam ActivityDiamondBackgroundColor #FAFAFA
skinparam swimlaneBorderColor #AAAAAA
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam dpi 150
title BP-04 — Khám bệnh từ xa WebRTC (P2P + coturn STUN/TURN)

|Bệnh nhân|
start
:Mở phòng chờ; kiểm tra camera / microphone;
:Xác nhận đồng ý tham gia (consent = true);

|Hệ thống|
if (Chủ sở hữu, REMOTE CONFIRMED, cửa sổ [T-10p, T+15p)?) then (có)
  :Chuẩn bị phiên duy nhất (CREATED -> WAITING);
  :Phát hành X-Room-Token ngẫu nhiên (TTL 300s, lưu SHA-256)\nvà cấu hình ICE (coturn STUN/TURN 3478);
else (không)
  :Từ chối tiếp nhận (409 / 422 / 404 + audit);
  stop
endif

|Bác sĩ|
if (Bắt đầu trong [T, T+15p)?) then (có)
else (quá T+15p mà bệnh nhân chưa vào)
  |Hệ thống|
  :Bác sĩ đánh dấu NO_SHOW (lưu no_show_reason,\nhủy phiên CANCELLED, thu hồi token);
  stop
endif

|Hệ thống|
:Xác thực bác sĩ được phân công và bệnh nhân WAITING;
:Đặt phiên ACTIVE, lịch IN_PROGRESS,\ntạo Encounter + audit nguyên tử;
:Trao đổi OFFER/ANSWER/ICE mã hóa AES-256-GCM qua /signals\nvà kết nối media P2P (qua coturn nếu sau NAT);

|Bác sĩ|
:Khám; lưu nháp hồ sơ bệnh án;
if (Phương tiện bị gián đoạn?) then (có)
  :Cập nhật trạng thái RECONNECTING -> ICE restart\nhoặc chuyển chế độ chỉ âm thanh;
  if (Có thể tiếp tục?) then (không)
    :Ghi lý do gián đoạn và hướng dẫn theo dõi;
  endif
endif
:Phát hành đơn thuốc nếu phù hợp;
:Kết thúc phiên từ xa (POST /end);

|Hệ thống|
:Đặt ENDED, thu hồi tức thì telehealth_token\nvà xóa telehealth_signal cùng giao dịch + audit;

|Bác sĩ|
if (Hồ sơ sẵn sàng?) then (có)
  :Chốt hồ sơ (FINAL); yêu cầu hoàn tất Encounter;
  |Hệ thống|
  :Kiểm tra hồ sơ FINAL và phiên ENDED;\nhoàn tất Encounter và lịch COMPLETED nguyên tử;
else (chưa chốt)
  |Hệ thống|
  :Giữ Encounter mở để bác sĩ hoàn thiện và chốt sau;
endif

stop
@enduml
