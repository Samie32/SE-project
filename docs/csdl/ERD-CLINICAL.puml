@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 150
skinparam backgroundColor white
skinparam roundcorner 0
skinparam ArrowColor black
skinparam packageStyle rectangle
title ERD clinical
hide circle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 55
entity app_users {
 * id : uuid <<PK>>
 * status : varchar(16)
 * version : integer
}
entity doctors {
 * id : uuid <<PK>>
 * user_id : uuid <<FK>>
 * specialty_id : uuid <<FK>>
 * version : integer
}
entity patients {
 * id : uuid <<PK>>
 owner_user_id : uuid <<FK>>
 * version : integer
}
entity health_profiles {
 * patient_id : uuid <<PK>>
 * key_id : varchar(32)
 verified_by : uuid <<FK>>
 * version : integer
}
entity health_profile_versions {
 * id : uuid <<PK>>
 * patient_id : uuid <<FK>>
 * payload_ciphertext : text
 * key_id : varchar(32)
 * actor_id : uuid <<FK>>
}
entity encounters {
 * id : uuid <<PK>>
 * appointment_id : uuid <<FK>>
 * doctor_id : uuid <<FK>>
 * status : varchar(20)
 key_id : varchar(32)
 * version : integer
}
entity clinical_records {
 * id : uuid <<PK>>
 * encounter_id : uuid <<FK>>
 * author_doctor_id : uuid <<FK>>
 * status : varchar(8)
 * payload_ciphertext : text
 * key_id : varchar(32)
 * version : integer
}
entity record_addenda {
 * id : uuid <<PK>>
 * record_id : uuid <<FK>>
 * author_doctor_id : uuid <<FK>>
 * sequence_no : integer
 * payload_ciphertext : text
 * key_id : varchar(32)
}
app_users ||--o| doctors : user_id
app_users |o--o| patients : owner_user_id
patients ||--o| health_profiles : patient_id
doctors |o--o{ health_profiles : verified_by
patients ||--o{ health_profile_versions : patient_id
app_users ||--o{ health_profile_versions : actor_id
doctors ||--o{ encounters : doctor_id
encounters ||--o| clinical_records : encounter_id
doctors ||--o{ clinical_records : author_doctor_id
clinical_records ||--o{ record_addenda : record_id
doctors ||--o{ record_addenda : author_doctor_id

@enduml
