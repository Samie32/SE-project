@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 150
skinparam backgroundColor white
skinparam roundcorner 0
skinparam ArrowColor black
skinparam packageStyle rectangle
title ERD platform
hide circle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 55
entity app_users {
 * id : uuid <<PK>>
 * status : varchar(16)
 * version : integer
}
entity patients {
 * id : uuid <<PK>>
 owner_user_id : uuid <<FK>>
 * version : integer
}
entity patient_link_verifications {
 * id : uuid <<PK>>
 * patient_id : uuid <<FK>>
 * account_id : uuid <<FK>>
 * actor_id : uuid <<FK>>
}
entity audit_chain_heads {
}
entity audit_events {
 * id : uuid <<PK>>
 * sequence_no : bigint
 actor_id : uuid <<FK>>
 patient_id : uuid <<FK>>
}
entity security_events {
 * id : uuid <<PK>>
 actor_id : uuid <<FK>>
}
entity access_alerts {
 * id : uuid <<PK>>
 actor_id : uuid <<FK>>
 acknowledged_by : uuid <<FK>>
}
entity backup_runs {
 * id : uuid <<PK>>
 * status : varchar(16)
}
app_users |o--o| patients : owner_user_id
patients ||--o{ patient_link_verifications : patient_id
app_users ||--o{ patient_link_verifications : account_id
app_users ||--o{ patient_link_verifications : actor_id
app_users |o--o{ audit_events : actor_id
patients |o--o{ audit_events : patient_id
app_users |o--o{ security_events : actor_id
app_users |o--o{ access_alerts : actor_id
app_users |o--o{ access_alerts : acknowledged_by

@enduml
