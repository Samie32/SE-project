@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 150
skinparam backgroundColor white
skinparam roundcorner 0
skinparam ArrowColor black
skinparam packageStyle rectangle
title ERD appointment
hide circle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 55
entity branches {
 * id : uuid <<PK>>
 * version : integer
}
entity doctors {
 * id : uuid <<PK>>
 * user_id : uuid <<FK>>
 * specialty_id : uuid <<FK>>
 * version : integer
}
entity patients {
 * id : uuid <<PK>>
 owner_user_id : uuid <<FK>>
 * version : integer
}
entity slots {
 * id : uuid <<PK>>
 * shift_id : uuid <<FK>>
 * starts_at : timestamptz
 * ends_at : timestamptz
}
entity appointments {
 * id : uuid <<PK>>
 * slot_id : uuid <<FK>>
 * patient_id : uuid <<FK>>
 * doctor_id : uuid <<FK>>
 * branch_id : uuid <<FK>>
 * starts_at : timestamptz
 * ends_at : timestamptz
 * status : varchar(16)
 * created_by : uuid <<FK>>
 * version : integer
}
entity appointment_history {
 * id : uuid <<PK>>
 * appointment_id : uuid <<FK>>
 before_slot_id : uuid <<FK>>
 * after_slot_id : uuid <<FK>>
 * actor_id : uuid <<FK>>
}
entity care_assignments {
 * id : uuid <<PK>>
 * appointment_id : uuid <<FK>>
 * patient_id : uuid <<FK>>
 * doctor_id : uuid <<FK>>
 * status : varchar(16)
 * version : integer
}
entity coordination_requests {
 * id : uuid <<PK>>
 * appointment_id : uuid <<FK>>
 proposed_slot_id : uuid <<FK>>
 * actor_id : uuid <<FK>>
}
entity encounters {
 * id : uuid <<PK>>
 * appointment_id : uuid <<FK>>
 * doctor_id : uuid <<FK>>
 * status : varchar(20)
 key_id : varchar(32)
 * version : integer
}
slots ||--o{ appointments : slot_id
patients ||--o{ appointments : patient_id
doctors ||--o{ appointments : doctor_id
branches ||--o{ appointments : branch_id
appointments ||--o{ appointment_history : appointment_id
slots |o--o{ appointment_history : before_slot_id
slots ||--o{ appointment_history : after_slot_id
appointments ||--o| care_assignments : appointment_id
patients ||--o{ care_assignments : patient_id
doctors ||--o{ care_assignments : doctor_id
appointments ||--o{ coordination_requests : appointment_id
slots |o--o{ coordination_requests : proposed_slot_id
appointments ||--o| encounters : appointment_id
doctors ||--o{ encounters : doctor_id

@enduml
