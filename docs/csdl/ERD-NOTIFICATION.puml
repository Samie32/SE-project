@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 150
skinparam backgroundColor white
skinparam roundcorner 0
skinparam ArrowColor black
skinparam packageStyle rectangle
title ERD notification
hide circle
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 55
entity app_users {
 * id : uuid <<PK>>
 * status : varchar(16)
 * version : integer
}
entity appointments {
 * id : uuid <<PK>>
 * slot_id : uuid <<FK>>
 * patient_id : uuid <<FK>>
 * doctor_id : uuid <<FK>>
 * branch_id : uuid <<FK>>
 * starts_at : timestamptz
 * ends_at : timestamptz
 * status : varchar(16)
 * created_by : uuid <<FK>>
 * version : integer
}
entity outbox_events {
 * id : uuid <<PK>>
 * event_type : varchar(40)
}
entity notification_configs {
 * id : uuid <<PK>>
 * actor_id : uuid <<FK>>
}
entity notifications {
 * id : uuid <<PK>>
 * appointment_id : uuid <<FK>>
 * config_id : uuid <<FK>>
 * event_type : varchar(32)
 * channel : varchar(5)
 * milestone : varchar(16)
 * status : varchar(16)
}
entity notification_attempts {
 * id : uuid <<PK>>
 * notification_id : uuid <<FK>>
}
entity webhook_receipts {
 * id : uuid <<PK>>
}
entity idempotency_records {
 * actor_id : uuid <<FK>>
}
app_users ||--o{ appointments : created_by
app_users ||--o{ notification_configs : actor_id
appointments ||--o{ notifications : appointment_id
notification_configs ||--o{ notifications : config_id
notifications ||--o{ notification_attempts : notification_id
app_users ||--o{ idempotency_records : actor_id

@enduml
