{
  "realm": "clinic",
  "enabled": true,
  "registrationAllowed": false,
  "loginTheme": "cliniccare",
  "rememberMe": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "clinic-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "clinic-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "clinic-local-cli",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "clinic-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
