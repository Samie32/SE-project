{$APP_HOST} {
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://{$AUTH_HOST}; frame-src 'self' https://{$AUTH_HOST}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}
	handle /api/webrtc/ice {
		reverse_proxy ice-config:8090
	}
	handle {
		reverse_proxy frontend:80
	}
}

{$AUTH_HOST} {
	@cliniccare_theme path_regexp ^/resources/[^/]+/login/cliniccare/
	handle @cliniccare_theme {
		reverse_proxy keycloak:8080 {
			header_up Accept-Encoding identity
			header_down Cache-Control "no-cache"
		}
	}
	@oidc path /realms/clinic /realms/clinic/* /resources/*
	handle @oidc {
		reverse_proxy keycloak:8080
	}
	handle {
		respond 404
	}
}
