# Local development only. Run scripts/setup-local.ps1 to generate .env and realm.
DB_PASSWORD=replace-with-generated-value
MYSQL_ROOT_PASSWORD=replace-with-generated-value
KEYCLOAK_ADMIN_PASSWORD=replace-with-generated-value
# Configured by scripts/setup-staff-provisioning.py. Backend only.
KEYCLOAK_STAFF_CLIENT_SECRET=
DEMO_PASSWORD=DemoClinic
DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Mailpit local. Azure deploy can sync its SMTP credentials from GitHub Actions.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=clinic@example.test

# Frontend gộp: đây là build args công khai, thay đổi cần build lại image.
FE_BACKEND_CHECKIN=true
FE_BACKEND_QUEUE=true
FE_BACKEND_PROGRESS=true
FE_BACKEND_CLINICAL=true
FE_BACKEND_TELEHEALTH=true
FE_BACKEND_AUDIT=true
WEBRTC_ICE_CONFIG_URL=/webrtc-config.json
