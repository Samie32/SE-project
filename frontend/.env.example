# Chỉ đặt cấu hình công khai. KHÔNG đặt mật khẩu, token hay client secret ở đây.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/clinic
VITE_OIDC_CLIENT_ID=clinic-web
# Vite dev server chuyển /api tới backend này.
API_PROXY_TARGET=http://localhost:8080
# JSON runtime chứa ICE servers; có thể trỏ tới endpoint cùng origin /api/... có JWT.
# Không nhúng TURN password dài hạn vào VITE_*.
VITE_WEBRTC_ICE_CONFIG_URL=/webrtc-config.json

# Các API hiện có của backend; false dùng để khóa riêng chức năng đang bảo trì.
# Khi chạy xuyên NAT cần ICE/TURN runtime phù hợp.
VITE_BACKEND_CHECKIN=true     # POST /appointments/{id}/check-in
VITE_BACKEND_QUEUE=true       # GET /doctors/{id}/queue?date= và POST next/skip
VITE_BACKEND_PROGRESS=true    # POST /appointments/{id}/progress (bắt đầu/hoàn tất/NO_SHOW)
VITE_BACKEND_CLINICAL=true    # hồ sơ bệnh án + đơn thuốc
VITE_BACKEND_TELEHEALTH=true  # phiên khám từ xa
VITE_BACKEND_AUDIT=true       # GET /audit-events
