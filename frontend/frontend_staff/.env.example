# Public frontend settings only. Never put passwords, tokens or client secrets here.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/clinic
VITE_OIDC_CLIENT_ID=clinic-web
# Vite dev server forwards /api to this backend.
API_PROXY_TARGET=http://localhost:8080

# Where DOCTOR / PATIENT accounts are sent when they open the staff area.
# Leave empty if the other frontends are not deployed on a different origin.
VITE_DOCTOR_URL=
VITE_PATIENT_URL=

# Backend capability flags. Set to true ONLY after the backend implements the endpoint
# (see README "Backend còn thiếu"). While false the UI is built but actions stay disabled.
VITE_BACKEND_CHECKIN=false
VITE_BACKEND_QUEUE=false
VITE_BACKEND_AUDIT=false
